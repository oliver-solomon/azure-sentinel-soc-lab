// Microsoft Sentinel SOC Lab — KQL Investigation Queries
// Run each numbered query separately in Azure Log Analytics.
// Results depend on the selected time range and available SecurityEvent data.
// GeoIP queries require the "geoip" Microsoft Sentinel watchlist.

// 01 — Verify Windows security log ingestion
SecurityEvent
| take 20


// 02 — Failed logons by targeted account (Event ID 4625)
SecurityEvent
| where EventID == 4625
| summarize FailedAttempts=count() by Account
| order by FailedAttempts desc


// 03 — Failed logons by source IP (before enrichment)
SecurityEvent
| where EventID == 4625
| summarize FailedAttempts=count() by IpAddress
| order by FailedAttempts desc


// 04 — Validate the GeoIP watchlist
_GetWatchlist("geoip")
| take 20


// 05 — Enrich failed logons with approximate geolocation
let GeoIPDB_FULL = _GetWatchlist("geoip");
SecurityEvent
| where EventID == 4625
| where IpAddress != "-"
| evaluate ipv4_lookup(GeoIPDB_FULL, IpAddress, network)
| project TimeGenerated, IpAddress, Account, cityname, countryname, latitude, longitude
| order by TimeGenerated desc


// 06 — Count failed logons by source IP and GeoIP country
// Caution: overlapping GeoIP CIDR ranges can duplicate matched events.
let GeoIPDB_FULL = _GetWatchlist("geoip");
SecurityEvent
| where EventID == 4625
| where IpAddress != "-"
| evaluate ipv4_lookup(GeoIPDB_FULL, IpAddress, network)
| summarize FailedAttempts=count() by IpAddress, countryname
| order by FailedAttempts desc


// 07 — Investigate original failed events for an IP with inflated GeoIP counts
SecurityEvent
| where EventID == 4625
| where IpAddress == "172.216.11.33"
| summarize FailedAttempts=count()


// 08 — Identify overlapping GeoIP CIDR matches for the same IP
let GeoIPDB_FULL = _GetWatchlist("geoip");
GeoIPDB_FULL
| where ipv4_is_in_range("172.216.11.33", network)
| project network, countryname, cityname


// 09 — Successful logons by logon type (Event ID 4624)
SecurityEvent
| where EventID == 4624
| summarize SuccessfulLogins=count() by LogonType
| order by SuccessfulLogins desc


// 10 — Investigate service logons (Type 5)
SecurityEvent
| where EventID == 4624
| where LogonType == 5
| summarize SuccessfulLogins=count() by Account, Process
| order by SuccessfulLogins desc


// 11 — Inspect network logons and session unlocks (Types 3 and 7)
SecurityEvent
| where EventID == 4624
| where LogonType in (3, 7)
| project TimeGenerated, Account, IpAddress, LogonType, Process
| order by TimeGenerated desc


// 12 — Check remote-interactive logons (Type 10)
SecurityEvent
| where EventID == 4624
| where LogonType == 10
| project TimeGenerated, Account, IpAddress, LogonType
| order by TimeGenerated desc
